package-as: NameScore

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

# The libraries for the minimap button are committed in Libs/ (no externals),
# so building a release needs no downloads. They keep their own licenses.
# Sources for updating them: LibStub, CallbackHandler-1.0, LibDBIcon-1.0 on
# repos.curseforge.com/wow/..., LibDataBroker-1.1 on github.com/tekkub/libdatabroker-1-1

ignore:
  - README.md
  - TODO.md
  - docs
  - media/icon.svg
  - media/icon-400.png
